#!/usr/bin/env bash
# Auto-bump VERSION (patch) on every push, commit it, then push including the bump.
set -euo pipefail

if [ "${SKIP_VERSION_BUMP:-}" = "1" ]; then
  exit 0
fi

remote="${1:-origin}"
ROOT="$(git rev-parse --show-toplevel)"
cd "$ROOT"

has_branch_update=0
while read -r local_ref local_sha remote_ref remote_sha; do
  [ -z "${local_ref:-}" ] && continue
  case "$local_ref" in
    refs/heads/*|HEAD) has_branch_update=1 ;;
  esac
done
if [ "$has_branch_update" -eq 0 ]; then
  exit 0
fi

if ! git diff --cached --quiet; then
  echo "pre-push: staged changes present; skipping auto version bump." >&2
  exit 0
fi

# Second pass after bump commit — allow the push through.
if git log -1 --pretty=%s | grep -qE '^chore: bump version to '; then
  exit 0
fi

before="$(tr -d '[:space:]' < VERSION)"
next="$("$ROOT/scripts/bump-version.sh")"
git add VERSION frontend-react/package.json

if git diff --cached --quiet; then
  exit 0
fi

git commit -m "chore: bump version to ${next}"
echo "pre-push: bumped ${before} -> ${next}; publishing with version commit..."
SKIP_VERSION_BUMP=1 git push "$remote" HEAD
# Abort the original push (it would omit the new commit). Nested push already published HEAD.
exit 1
